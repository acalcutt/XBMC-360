<window id="0">
	<!-- MediaRiffle's home: a top bar (name, tabs, time) like the web app's, and under it the focused tab's tiles.
	     A tab opens its window; down goes to its tiles -->
	<defaultcontrol always="true">9000</defaultcontrol>
	<allowoverlay>no</allowoverlay>
	<controls>
		<include>CommonBackground</include>

		<!-- Top bar -->
		<control type="group">
			<include>Window_OpenClose_Animation</include>
			<control type="image">
				<posx>0</posx>
				<posy>0</posy>
				<width>1280</width>
				<height>104</height>
				<texture>mr-fill.png</texture>
				<colordiffuse>mr_surface</colordiffuse>
			</control>
			<control type="image">
				<posx>0</posx>
				<posy>104</posy>
				<width>1280</width>
				<height>1</height>
				<texture>mr-fill.png</texture>
				<colordiffuse>mr_border</colordiffuse>
			</control>
			<control type="label">
				<description>Name</description>
				<posx>64</posx>
				<posy>36</posy>
				<width>220</width>
				<height>48</height>
				<font>font28_title</font>
				<textcolor>mr_text</textcolor>
				<aligny>center</aligny>
				<label>360 Riffle</label>
			</control>
			<control type="list" id="9000">
				<description>Tabs</description>
				<posx>300</posx>
				<posy>36</posy>
				<width>728</width>
				<height>48</height>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<ondown>9001</ondown>
				<orientation>horizontal</orientation>
				<scrolltime>200</scrolltime>
				<itemlayout width="104" height="48">
					<control type="label">
						<posx>48</posx>
						<posy>0</posy>
						<width>96</width>
						<height>48</height>
						<font>font13_title</font>
						<textcolor>mr_muted</textcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="104" height="48">
					<!-- The accent while the tabs have the focus; down in the tiles, the tab they belong to stays marked -->
					<control type="image">
						<posx>0</posx>
						<posy>0</posy>
						<width>96</width>
						<height>48</height>
						<texture border="16">mr-round.png</texture>
						<colordiffuse>mr_accent</colordiffuse>
						<visible>Control.HasFocus(9000)</visible>
					</control>
					<control type="image">
						<posx>0</posx>
						<posy>0</posy>
						<width>96</width>
						<height>48</height>
						<texture border="16">mr-round.png</texture>
						<colordiffuse>mr_border</colordiffuse>
						<visible>!Control.HasFocus(9000)</visible>
					</control>
					<control type="label">
						<posx>48</posx>
						<posy>0</posy>
						<width>96</width>
						<height>48</height>
						<font>font13_title</font>
						<textcolor>white</textcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
				<!-- A on a tab goes down to its tiles, as down does: the tiles are what the tab has -->
				<content>
					<item id="7">
						<label>13238</label>
						<onclick>SetFocus(9001)</onclick>
						<visible>System.HasDisc</visible>
					</item>
					<item id="1">
						<label>31960</label>
						<onclick>SetFocus(9001)</onclick>
					</item>
					<item id="2">
						<label>31961</label>
						<onclick>SetFocus(9001)</onclick>
					</item>
					<item id="3">
						<label>31962</label>
						<onclick>SetFocus(9001)</onclick>
					</item>
					<item id="4">
						<label>31963</label>
						<onclick>SetFocus(9001)</onclick>
					</item>
					<item id="5">
						<label>31964</label>
						<onclick>SetFocus(9001)</onclick>
					</item>
					<item id="6">
						<label>31965</label>
						<onclick>SetFocus(9001)</onclick>
					</item>
				</content>
			</control>
			<control type="label">
				<description>Time</description>
				<posx>64r</posx>
				<posy>36</posy>
				<width>160</width>
				<height>48</height>
				<font>font13_title</font>
				<textcolor>mr_muted</textcolor>
				<align>right</align>
				<aligny>center</aligny>
				<label>$INFO[System.Time]</label>
			</control>
		</control>

		<!-- The focused tab: its name, and its tiles. Videos, Games, Music and Pictures (9101-9104) are their sources,
		     filled by the window (GUIWindowHome); the Disc, Files and Settings tiles are these -->
		<control type="group" id="9001">
			<posx>0</posx>
			<posy>144</posy>
			<include>Window_OpenClose_Animation</include>
			<control type="label">
				<posx>64</posx>
				<posy>0</posy>
				<width>1152</width>
				<height>48</height>
				<font>font30_title</font>
				<textcolor>mr_text</textcolor>
				<aligny>center</aligny>
				<label>$INFO[Container(9000).ListItem.Label]</label>
			</control>
			<control type="list" id="9107">
				<include>HomeTileRow</include>
				<visible>Container(9000).HasFocus(7)</visible>
				<content>
					<item>
						<label>$INFO[System.DiscType]</label>
						<label2>$INFO[System.DiscName]</label2>
						<onclick>PlayDisc</onclick>
					</item>
					<item>
						<label>13218</label>
						<label2>13239</label2>
						<onclick>CopyDisc</onclick>
					</item>
					<item>
						<label>13219</label>
						<label2>13240</label2>
						<onclick>SaveDiscImage</onclick>
					</item>
					<item>
						<label>13391</label>
						<label2>13241</label2>
						<onclick>EjectTray</onclick>
					</item>
				</content>
			</control>
			<control type="list" id="9101">
				<include>HomeTileRow</include>
				<visible>Container(9000).HasFocus(1)</visible>
			</control>
			<control type="list" id="9102">
				<include>HomeTileRow</include>
				<visible>Container(9000).HasFocus(2)</visible>
			</control>
			<control type="list" id="9103">
				<include>HomeTileRow</include>
				<visible>Container(9000).HasFocus(3)</visible>
			</control>
			<control type="list" id="9104">
				<include>HomeTileRow</include>
				<visible>Container(9000).HasFocus(4)</visible>
			</control>
			<control type="list" id="9105">
				<include>HomeTileRow</include>
				<visible>Container(9000).HasFocus(5)</visible>
				<content>
					<item>
						<label>31973</label>
						<label2>31974</label2>
						<onclick>ActivateWindow(FileManager)</onclick>
					</item>
				</content>
			</control>
			<control type="list" id="9106">
				<include>HomeTileRow</include>
				<visible>Container(9000).HasFocus(6)</visible>
				<content>
					<item>
						<label>31965</label>
						<label2>31978</label2>
						<onclick>ActivateWindow(Settings)</onclick>
					</item>
					<item>
						<label>13189</label>
						<label2>13237</label2>
						<onclick>ActivateWindow(Sources)</onclick>
					</item>
					<item>
						<label>31980</label>
						<label2>31977</label2>
						<onclick>ActivateWindow(ShutdownMenu)</onclick>
					</item>
				</content>
			</control>
		</control>

		<!-- Now playing: a card at the bottom while something plays -->
		<control type="group">
			<posx>64</posx>
			<posy>568</posy>
			<width>1152</width>
			<height>100</height>
			<visible>Player.HasMedia</visible>
			<include>VisibleFadeEffect</include>
			<include>Window_OpenClose_Animation</include>
			<control type="image">
				<posx>0</posx>
				<posy>0</posy>
				<width>1152</width>
				<height>100</height>
				<texture border="16">mr-card.png</texture>
			</control>
			<control type="label">
				<posx>24</posx>
				<posy>16</posy>
				<width>900</width>
				<height>28</height>
				<font>font12</font>
				<textcolor>mr_muted</textcolor>
				<aligny>center</aligny>
				<label>31979</label>
			</control>
			<control type="label">
				<posx>24</posx>
				<posy>46</posy>
				<width>900</width>
				<height>36</height>
				<font>font16</font>
				<textcolor>mr_text</textcolor>
				<aligny>center</aligny>
				<label>$INFO[VideoPlayer.Title]$INFO[MusicPlayer.Artist,, - ]$INFO[MusicPlayer.Title]</label>
			</control>
			<control type="label">
				<posx>24r</posx>
				<posy>46</posy>
				<width>200</width>
				<height>36</height>
				<font>font13</font>
				<textcolor>mr_muted</textcolor>
				<align>right</align>
				<aligny>center</aligny>
				<label>$INFO[Player.Time]$INFO[Player.Duration, / ]</label>
			</control>
		</control>
	</controls>
</window>
